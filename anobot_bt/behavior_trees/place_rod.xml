<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="PlaceRod">
  <BehaviorTree ID="PlaceRod">
    <Sequence name="PlaceRodSequence">
      <AcquireWorkstation message="{acquire_message}"/>
      <ApplyWorkstationScene message="{scene_message}"/>
      <VerifyWorkstationAcquired message="{acquired_status}"/>
      <VerifyWorkstationSceneApplied message="{scene_status}"/>
      <VerifyRodAttached message="{initial_attached_status}"/>
      <PlanPregrasp message="{plan_pregrasp_message}"/>
      <ExecutePregrasp message="{execute_pregrasp_message}"/>
      <PlanLinearGrasp message="{plan_grasp_message}"/>
      <ExecuteLinearGrasp message="{execute_grasp_message}"/>
      <DetachRod message="{detach_message}"/>
      <VerifyRodAtWorkstation message="{workstation_status}"/>
      <PlanLinearRetreat message="{plan_retreat_message}"/>
      <ExecuteLinearRetreat message="{execute_retreat_message}"/>
      <PlanCameraViewPose message="{plan_camera_view_message}"/>
      <ExecuteCameraViewPose message="{execute_camera_view_message}"/>
      <VerifyRodAtWorkstation message="{final_workstation_status}"/>
    </Sequence>
  </BehaviorTree>
</root>